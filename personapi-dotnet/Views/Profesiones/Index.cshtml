@model IEnumerable<personapi_dotnet.Models.Entities.Profesion>
@{ ViewData["Title"] = "Profesiones"; }
<h1>Profesiones</h1>
<p><a asp-action="Create" class="btn btn-primary">Crear profesión</a></p>
<table class="table table-striped">
    <thead><tr><th>@Html.DisplayNameFor(m => m.First().Id)</th><th>@Html.DisplayNameFor(m => m.First().Nom)</th><th>@Html.DisplayNameFor(m => m.First().Des)</th><th></th></tr></thead>
    <tbody>
@foreach (var item in Model) {
        <tr><td>@item.Id</td><td>@item.Nom</td><td>@item.Des</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Detalle</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
